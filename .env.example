# Base URL for frontend API calls (defaults to /api)
NEXT_PUBLIC_API_URL=/api

# Canonical site URL for Open Graph, SEO, and Sitemap
NEXT_PUBLIC_SITE_URL=https://salmansiddikshovo.vercel.app

# Resend API key for sending contact form emails (get free key at https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Email address where contact form submissions should be delivered
CONTACT_TO_EMAIL=salmansiddikshovo@gmail.com
